<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.rabbitmq.client</groupId>
  <artifactId>jms-client-guide</artifactId>
  <version>1.0.0</version>
  <packaging>pom</packaging>
  <name>RabbitMQ AMQP JMS Client Guide</name>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <build>
    <plugins>
      <plugin>
        <groupId>org.asciidoctor</groupId>
        <artifactId>asciidoctor-maven-plugin</artifactId>
        <version>3.2.0</version>
        <dependencies>
          <dependency>
            <groupId>org.asciidoctor</groupId>
            <artifactId>asciidoctorj</artifactId>
            <version>3.0.1</version>
          </dependency>
        </dependencies>
        <configuration>
          <sourceDirectory>${project.basedir}/asciidoc</sourceDirectory>
          <sourceDocumentName>index.adoc</sourceDocumentName>
          <outputDirectory>${project.build.directory}/htmlsingle</outputDirectory>
          <backend>html5</backend>
          <attributes>
            <toc>left</toc>
            <sectanchors>true</sectanchors>
            <idprefix />
            <idseparator>-</idseparator>
            <reproducible>true</reproducible>
            <attribute-missing>warn</attribute-missing>
          </attributes>
          <logHandler>
            <failIf>
              <severity>WARN</severity>
            </failIf>
          </logHandler>
        </configuration>
        <executions>
          <execution>
            <id>generate-guide</id>
            <phase>generate-resources</phase>
            <goals>
              <goal>process-asciidoc</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
